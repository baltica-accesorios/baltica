# Base de datos (Neon en producción, docker-compose en local)
DATABASE_URL=postgres://baltica:baltica@localhost:5433/baltica

# Dirección pública del sitio, sin barra final (se usa para los links de vuelta de Mercado Pago)
SITE_URL=http://localhost:3000

# Mercado Pago: credenciales de la cuenta de Báltica (Tus integraciones → Credenciales).
# Empezar con las de prueba (TEST-...) y cambiarlas por las de producción para cobrar de verdad.
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones → Webhooks → Clave secreta)
MP_WEBHOOK_SECRET=
